# Aliases for Et Futurum Requiem (Minecraft 1.7.10 mod): the names modern Skript uses for blocks and items that
# were added after 1.7.10. Only loads when the mod is installed. Items not listed here still get names generated
# from the server's item names (see Aliases#loadMissingAliases), e.g. "etfuturum cherry planks".
# Registry names are "etfuturum:" + the lowercase enum names of ModBlocks/ModItems.

et futurum stones:
	mod = etfuturum
	[raw] granite¦s = etfuturum:stone {Damage:1}
	(smooth|polished) granite¦s = etfuturum:stone {Damage:2}
	any granite¦s = raw granite, polished granite
	[raw] diorite¦s = etfuturum:stone {Damage:3}
	(smooth|polished) diorite¦s = etfuturum:stone {Damage:4}
	any diorite¦s = raw diorite, polished diorite
	[raw] andesite¦s = etfuturum:stone {Damage:5}
	(smooth|polished) andesite¦s = etfuturum:stone {Damage:6}
	any andesite¦s = raw andesite, polished andesite
	any [natural] stone¦s = stone, any granite, any diorite, any andesite
	coarse dirt [block¦s] = etfuturum:coarse_dirt
	granite stair¦s = etfuturum:granite_stairs
	polished granite stair¦s = etfuturum:polished_granite_stairs
	diorite stair¦s = etfuturum:diorite_stairs
	polished diorite stair¦s = etfuturum:polished_diorite_stairs
	andesite stair¦s = etfuturum:andesite_stairs
	polished andesite stair¦s = etfuturum:polished_andesite_stairs
	smooth stone [block¦s] = etfuturum:smooth_stone
	smooth quartz [block¦s] = etfuturum:smooth_quartz
	quartz brick¦s = etfuturum:quartz_bricks
	(grass|dirt) path [block¦s] = etfuturum:grass_path

